APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_TIMEOUT_MINUTES=15
SESSION_WARNING_MINUTES=2

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_APPLICANT_REDIRECT_URI=
# Comma-separated email domains allowed for admin Google Sign-In (blank = any registered email)
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_VERIFY_SSL=true

# -----------------------------------------------------------------------------
# Production (Railway) reference
# -----------------------------------------------------------------------------
# Required service variables:
#   APP_ENV=production, APP_DEBUG=false, APP_KEY (php artisan key:generate --show)
#   APP_URL=https://<your-domain>          # set after generating the Railway domain
#   LOG_CHANNEL=stderr                      # logs go to Railway's log stream
#   SESSION_DRIVER=database, SESSION_SECURE_COOKIE=true
#   CACHE_STORE=database, QUEUE_CONNECTION=sync   # no queue worker is deployed
#   DB_CONNECTION=mysql, DB_URL=${{MySQL.MYSQL_URL}}   # Railway MySQL reference
#   MAIL_MAILER=log                         # switch to smtp once verified
#   VITE_APP_NAME=...                       # baked into assets at build time
#   GOOGLE_REDIRECT_URI=https://<your-domain>/auth/google/callback
#   GOOGLE_APPLICANT_REDIRECT_URI=https://<your-domain>/applicant/auth/google/callback
#
# Infrastructure (see start-container.sh, which Railway runs on boot):
#   Volume mounted at /app/storage/app        # uploads + landing_settings.json
#   Pre-deploy: php artisan config:clear && php artisan migrate --force && php artisan db:seed --force
#   Healthcheck path: /up
#   Cron service start command: php artisan schedule:work (set RAILPACK_SKIP_MIGRATIONS=true there)
